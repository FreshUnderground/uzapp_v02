<IfModule mod_rewrite.c>
  RewriteEngine On

  # API folder — never rewrite
  RewriteRule ^api/ - [L]

  # Smart bridge fallback → Flutter web
  RewriteCond %{QUERY_STRING} (^|&)web=1(&|$) [NC]
  RewriteRule ^(product|shop)/ /index.html [L]

  # Social preview bots → Open Graph PHP pages
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Googlebot|bingbot|Pinterest|Embedly) [NC]
  RewriteRule ^product/([^/]+)/?$ /api/product_page.php?id=$1 [L,QSA]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Googlebot|bingbot|Pinterest|Embedly) [NC]
  RewriteRule ^shop/([^/]+)/?$ /api/shop_page.php?id=$1 [L,QSA]

  # Mobile → try native app, then web
  RewriteCond %{HTTP_USER_AGENT} (Android|iPhone|iPad|iPod|Mobile|webOS|BlackBerry|IEMobile|Opera\sMini) [NC]
  RewriteRule ^product/([^/]+)/?$ /api/product_page.php?id=$1&bridge=1 [L,QSA]

  RewriteCond %{HTTP_USER_AGENT} (Android|iPhone|iPad|iPod|Mobile|webOS|BlackBerry|IEMobile|Opera\sMini) [NC]
  RewriteRule ^shop/([^/]+)/?$ /api/shop_page.php?id=$1&bridge=1 [L,QSA]

  # Desktop / fallback — Flutter web (explicit, no file/dir check)
  RewriteRule ^product/([^/]+)/?$ /index.html [L]
  RewriteRule ^shop/([^/]+)/?$ /index.html [L]

  # Other SPA routes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: blob: https:; manifest-src 'self'; style-src 'self' 'unsafe-inline' data: https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://www.gstatic.com; connect-src 'self' http://localhost:* http://127.0.0.1:* http://192.168.1.100:* https://uzaapp.com https://investee-group.com https://www.gstatic.com https://fonts.gstatic.com; worker-src 'self' blob:;"
</IfModule>
