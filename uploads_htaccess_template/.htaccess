# CORS Configuration for Uploads Directory
# This file should be placed in /htdocs/uzaapp.com/uploads/.htaccess

<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, User-Agent, Accept"
    Header always set Access-Control-Max-Age "86400"
    
    # Cache static assets for better performance
    <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Prevent directory listing
Options -Indexes
