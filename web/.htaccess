<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: blob: https:; manifest-src 'self'; style-src 'self' 'unsafe-inline' data: https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://www.gstatic.com; connect-src 'self' http://localhost:* http://127.0.0.1:* http://192.168.1.100:* https://uzaapp.com https://investee-group.com https://www.gstatic.com https://fonts.gstatic.com; worker-src 'self' blob:;"
</IfModule>
