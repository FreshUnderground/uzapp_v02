<IfModule mod_rewrite.c>

  RewriteEngine On



  # API folder — never rewrite

  RewriteRule ^api/ - [L]

  # Admin stats dashboard
  RewriteRule ^statistiques/?$ /api/statistiques.php [L,QSA]

  # Smart bridge fallback → Flutter web

  RewriteCond %{QUERY_STRING} (^|&)web=1(&|$) [NC]

  RewriteRule ^(product|shop|ya-cope)/ /index.html [L]



  # Social preview bots → Open Graph PHP pages

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Googlebot|bingbot|Pinterest|Embedly) [NC]

  RewriteRule ^product/([^/]+)/?$ /api/product_page.php?id=$1 [L,QSA]



  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Googlebot|bingbot|Pinterest|Embedly) [NC]

  RewriteRule ^shop/([^/]+)/?$ /api/shop_page.php?id=$1 [L,QSA]



  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Googlebot|bingbot|Pinterest|Embedly) [NC]

  RewriteRule ^ya-cope/([^/]+)/?$ /api/ya_cope_page.php?id=$1 [L,QSA]



  # Mobile → product landing (image + WhatsApp contact)

  RewriteCond %{HTTP_USER_AGENT} (Android|iPhone|iPad|iPod|Mobile|webOS|BlackBerry|IEMobile|Opera\sMini) [NC]

  RewriteRule ^product/([^/]+)/?$ /api/product_page.php?id=$1 [L,QSA]



  # Mobile → shop landing (logo + WhatsApp contact)

  RewriteCond %{HTTP_USER_AGENT} (Android|iPhone|iPad|iPod|Mobile|webOS|BlackBerry|IEMobile|Opera\sMini) [NC]

  RewriteRule ^shop/([^/]+)/?$ /api/shop_page.php?id=$1 [L,QSA]



  # Mobile → Ya Cope landing

  RewriteCond %{HTTP_USER_AGENT} (Android|iPhone|iPad|iPod|Mobile|webOS|BlackBerry|IEMobile|Opera\sMini) [NC]

  RewriteRule ^ya-cope/([^/]+)/?$ /api/ya_cope_page.php?id=$1 [L,QSA]



  # Desktop / fallback — Flutter web (explicit, no file/dir check)

  RewriteRule ^product/([^/]+)/?$ /index.html [L]

  RewriteRule ^shop/([^/]+)/?$ /index.html [L]

  RewriteRule ^ya-cope/([^/]+)/?$ /index.html [L]



  # Missing upload files → 404 (never serve SPA HTML as an image)

  RewriteCond %{REQUEST_URI} ^/uploads/ [NC]

  RewriteCond %{REQUEST_FILENAME} !-f

  RewriteRule ^ - [R=404,L]



  # Other SPA routes

  RewriteCond %{REQUEST_FILENAME} !-f

  RewriteCond %{REQUEST_FILENAME} !-d

  RewriteRule ^ /index.html [L]

</IfModule>



<IfModule mod_headers.c>

  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: blob: https:; manifest-src 'self'; style-src 'self' 'unsafe-inline' data: https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://www.gstatic.com https://cdn.jsdelivr.net; connect-src 'self' http://localhost:* http://127.0.0.1:* http://192.168.1.100:* https://uzaapp.com https://investee-group.com https://www.gstatic.com https://fonts.gstatic.com https://cdn.jsdelivr.net; worker-src 'self' blob:;"

</IfModule>

